{
  "name": "loomic",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "ci:check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "validate:env": "pnpm --filter @loomic/config build && node scripts/validate-env-template.mjs",
    "test:workspace": "pnpm validate:env && node --test tests/workspace.test.mjs",
    "test:packages": "turbo run test",
    "test:e2e": "node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "test": "pnpm run test:workspace && pnpm run test:packages",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:test": "supabase test db",
    "seed": "node scripts/seed-test-accounts.mjs",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.62.1",
    "supabase": "^2.115.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "global-agent": "^4.1.3"
  }
}
