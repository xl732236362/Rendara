{
  "name": "@loomic/config",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "node": {
        "types": "./dist/env.d.ts",
        "import": "./dist/env.js"
      },
      "default": null
    }
  },
  "files": ["dist"],
  "dependencies": {
    "zod": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run src/env.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
